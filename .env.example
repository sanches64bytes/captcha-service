DJANGO_SECRET_KEY=<development-secret-key>
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_TRUST_PROXY=false
DJANGO_HSTS_SECONDS=0
DB_NAME=captcha_api
DB_USER=captcha_api
DB_PASSWORD=<database-password>
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60
REDIS_PASSWORD=<redis-password>
REDIS_URL=redis://:redis-password@localhost:6379/0
CACHE_URL=redis://:redis-password@localhost:6379/2
CELERY_BROKER_URL=redis://:redis-password@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:redis-password@localhost:6379/1
CAPTCHA_TASK_TTL=1800
WEB_PORT=8000
WEB_WORKERS=3
WEB_TIMEOUT=120
CELERY_LOGLEVEL=INFO
CELERY_CONCURRENCY=4
CAPTCHAAI_API_KEY=<captchaai-api-key>
CAPTCHAAI_BASE_URL=https://ocr.captchaai.com
CAPTCHAAI_REQUEST_TIMEOUT=30
CAPTCHAAI_POLL_INTERVAL=5
CAPTCHAAI_TASK_TIMEOUT=120
